# The GitHub App's ID, from its settings page.
GITHUB_APP_ID=123456
# The Forgejo the bridge talks to.
FORGEJO_URL=https://forgejo.example.com
# The password of the bundled PostgreSQL.
DB_PASSWORD=change-me
# Your user and group (id -u, id -g), so the bridge can read secrets/.
BRIDGE_UID=1000
BRIDGE_GID=1000
# The image tag; latest is the newest release.
BRIDGE_VERSION=latest
# Where health and metrics are published on this host.
BRIDGE_PORT=8080
