{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":prImmediately"
  ],
  "baseBranchPatterns": [
    "develop"
  ],
  "automergeStrategy": "fast-forward",
  "labels": [
    "dependencies"
  ],
  "github-actions": {
    "enabled": false
  },
  "gomod": {
    "enabled": true
  },
  "helm-values": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group Go dependency updates",
      "matchManagers": [
        "gomod"
      ],
      "groupName": "go dependencies"
    },
    {
      "description": "Automerge patch updates",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "The console's TypeScript follows what Angular supports (the @angular/compiler-cli peer range); a major waits until Angular takes it",
      "matchFileNames": [
        "ui/package.json"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ],
  "platformAutomerge": false,
  "npmrc": "allow-remote=all",
  "npmrcMerge": true
}
